pipeline {
    agent any

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Source code is available in the Jenkins workspace.'
                bat 'dir'
            }
        }

        stage('Check Docker') {
            steps {
                bat '"C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" --version'
            }
        }

        stage('Build Application Image') {
            steps {
                bat '"C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -f docker/Dockerfile -t ecommerce-api:1.0 .'
            }
        }
    }
}