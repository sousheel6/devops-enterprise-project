
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '227769753769'
        ECR_REPOSITORY = 'ecommerce-api'
        EKS_CLUSTER    = 'devops-enterprise-cluster'
        K8S_DEPLOYMENT = 'ecommerce-api'
        K8S_CONTAINER  = 'ecommerce-api'
    }

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        
stage('Install Python Dependencies') {
    steps {
        bat '''
            python --version
            python -m pip install --upgrade pip
            python -m pip install flask pytest
        '''
    }
}


   
stage('Run Tests') {
    steps {
        bat '''
            python -m pytest app/tests/ -v
            if errorlevel 1 exit /b 1
        '''
    }
}


        stage('Build Docker Image') {
            steps {
                bat '''
                    docker build -t %ECR_REPOSITORY%:%BUILD_NUMBER% .
                    docker tag %ECR_REPOSITORY%:%BUILD_NUMBER% %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com/%ECR_REPOSITORY%:%BUILD_NUMBER%
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                bat '''
                    aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                bat '''
                    docker push %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com/%ECR_REPOSITORY%:%BUILD_NUMBER%
                '''
            }
        }

        stage('Configure EKS Access') {
            steps {
                bat '''
                    aws eks update-kubeconfig --name %EKS_CLUSTER% --region %AWS_REGION%
                    kubectl config current-context
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                bat '''
                    kubectl set image deployment/%K8S_DEPLOYMENT% %K8S_CONTAINER%=%AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com/%ECR_REPOSITORY%:%BUILD_NUMBER%
                    if errorlevel 1 exit /b 1

                    kubectl rollout status deployment/%K8S_DEPLOYMENT% --timeout=180s
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    kubectl get deployment %K8S_DEPLOYMENT%
                    kubectl get pods -o wide
                    kubectl get service ecommerce-api
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Tests passed, image pushed to ECR, and EKS deployment completed.'
        }

        failure {
            echo 'FAILURE: Check Console Output for the failed stage and error.'
        }

        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}