pipeline {
    agent any

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Source code is available in the Jenkins workspace.'
                bat 'dir'
            }
        }

        stage('Check Docker') {
            steps {
                bat '"C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" --version'
            }
        }

        stage('Build Application Image') {
            steps {
                bat '"C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -f docker/Dockerfile -t ecommerce-api:1.0 .'
            }
        }

        stage('Push Image to Amazon ECR') {
            steps {
                withAWS(credentials: 'aws-ecr-credentials', region: 'ap-south-1') {
                    script {
                        def accountId = bat(
                            script: '@"C:\\Program Files\\Amazon\\AWSCLIV2\\aws.exe" sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()

                        def registry = "${accountId}.dkr.ecr.ap-south-1.amazonaws.com"
                        def image = "${registry}/ecommerce-api:1.0"

                        bat """
                            "C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" tag ecommerce-api:1.0 ${image}
                        """

                        bat """
                            "C:\\Program Files\\Amazon\\AWSCLIV2\\aws.exe" ecr get-login-password --region ap-south-1 | "C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" login --username AWS --password-stdin ${registry}
                        """

                        bat """
                            "C:\\Users\\soush\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" push ${image}
                        """
                    }
                }

stage('Deploy to EKS') {
    steps {
        bat '''
            aws eks update-kubeconfig --name devops-enterprise-cluster --region ap-south-1
            kubectl set image deployment/ecommerce-api ecommerce-api=227769753769.dkr.ecr.ap-south-1.amazonaws.com/ecommerce-api:1.0
            kubectl rollout status deployment/ecommerce-api --timeout=180s
        '''
    }
}

            }
        }
    }
}
